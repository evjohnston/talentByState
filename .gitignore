data/states/*
!data/states/profiles/
data/states/profiles/*
!data/states/profiles/pdf/
data/states/profiles/pdf/*
!data/states/profiles/pdf/*.pdf

# environment and editor
.venv
.venv.nosync/
__pycache__/
*.pyc
.DS_Store
.impeccable/
.vscode/

# local pointer to RULES.md for the editor assistant (not tracked)
CLAUDE.md

# knowledge graph (graphify)
graphify-out/
