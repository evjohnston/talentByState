# secrets
.env
.env.*

# inputs (30 GB; tracked by manifests/sources_manifest.csv instead)
sources/
reference/digest/
reference/survey_forms/

# rebuildable outputs and caches
data/*
cache/
# except the PDF profiles, which are committed with every rebuild (the zips stay out: rebuildable, near 50 MB)
